# Copy to backend/.env and fill in. .env is gitignored.

# Postgres. Local default targets the `docker compose` service in the repo root.
# Point at a hosted DB (Neon/Supabase) by overriding this.
DATABASE_URL=postgresql+psycopg://sherlock:sherlock@localhost:5433/sherlock

# LLM (Phase 4). Leave ANTHROPIC_API_KEY unset to use templated fallbacks.
ANTHROPIC_API_KEY=
SHERLOCK_MODEL=claude-sonnet-5

# CORS: the frontend dev origin
FRONTEND_ORIGIN=http://localhost:3000

# Demo determinism
DEMO_SEED=7
